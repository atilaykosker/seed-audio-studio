{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // The "./src/*" fallback lets src/server/** (compiled under this root Next program) import
    // Vite-side src/services/** files that use "@/"=src, alongside the root-relative "@/app/..." usage.
    "paths": { "@/*": ["./*", "./src/*"] },
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // TS 6.0 flipped this default to true, which breaks the side-effect
    // import of ./globals.css in app/layout.tsx. Keep it false.
    "noUncheckedSideEffectImports": false,
    // Carried over from the deleted tsconfig.app.json so src/** (now covered by
    // this single project) keeps the same strictness it had under Vite.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["next-env.d.ts", "worker-configuration.d.ts", "app/**/*", "middleware.ts", "src/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
